# Non-secret environment overrides. Put credentials only in secrets.env.
KTA_ENVIRONMENT=development
KTA_BROKER_MODE=simulation
KTA_MARKET_DATA_MODE=synthetic
KTA_AGENT_MODE=heuristic
KTA_RESEARCH_MODE=none
KTA_DATABASE_PATH=var/kta.db
# Optional seed symbols. With discovery enabled these are context, not a boundary.
KTA_UNIVERSE=
KTA_INITIAL_SIMULATED_CASH=3000

# Paid-call pacing. The soft budget warns; hard enforcement is opt-in.
KTA_DECISION_COOLDOWN_HOURS=168
KTA_REVIEW_MIN_INTERVAL_HOURS=24
KTA_MONTHLY_API_SOFT_BUDGET_USD=100.00
KTA_MONTHLY_API_BUDGET_USD=1000.00
KTA_ENFORCE_MONTHLY_API_BUDGET=false
KTA_EXPECTED_SIGNAL_CYCLES_PER_MONTH=4
KTA_EXPECTED_REVIEWS_PER_MONTH=2

# Planning rates for `kta estimate-cost`; match these to the selected OpenRouter models.
KTA_ESTIMATED_LLM_INPUT_USD_PER_MILLION=0.30
KTA_ESTIMATED_LLM_OUTPUT_USD_PER_MILLION=2.50
KTA_OPENROUTER_CREDIT_FEE_PCT=0.055

# Intentionally aggressive market-risk profile.
KTA_MAX_POSITION_PCT=0.40
KTA_MAX_GROSS_EXPOSURE_PCT=1.00
KTA_MAX_NEW_EXPOSURE_PER_RUN_PCT=0.60
KTA_MAX_ORDERS_PER_RUN=5
KTA_MAX_DATA_AGE_DAYS=5
KTA_MINIMUM_CONFIDENCE=0.55
KTA_MINIMUM_ORDER_NOTIONAL=25
KTA_DAILY_LOSS_KILL_PCT=0.20
KTA_RISK_PER_TRADE_PCT=0.01
KTA_OPTIONS_ENABLED=false
KTA_SHORTING_ENABLED=false

# Long-running service. Configure the bearer token in secrets.env outside loopback.
KTA_DAEMON_HOST=127.0.0.1
KTA_DAEMON_PORT=8787
KTA_DAEMON_WORKERS=3
KTA_JOB_POLL_SECONDS=2
KTA_JOB_LEASE_SECONDS=14400
KTA_TRIGGER_POLL_SECONDS=30
KTA_DAILY_SCAN_HOUR_ET=16
KTA_DAILY_SCAN_MINUTE_ET=30
KTA_SCAN_ON_START=false

# Continuous discovery constructs a versioned universe from config/mandate.toml.
KTA_DISCOVERY_ENABLED=false
KTA_DISCOVERY_INTERVAL_HOURS=6
KTA_DISCOVERY_ON_START=true
KTA_SCAN_AFTER_DISCOVERY=true
KTA_DISCOVERY_MAX_CANDIDATES=250
KTA_DISCOVERY_MIN_PRICE=2
KTA_DISCOVERY_MIN_DAILY_DOLLAR_VOLUME=2000000

# Generous emergency loop guards, not target durations.
KTA_AGENTIC_RESEARCH_ENABLED=false
KTA_AGENT_MAX_TURNS=64
KTA_AGENT_MAX_RESEARCH_CALLS=32
KTA_AGENT_MAX_TOKENS_PER_TURN=8000
KTA_SUGGESTION_REVIEW_TTL_MINUTES=15

# Alpaca PAPER endpoints. Credentials live in secrets.env.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Model-role environment overrides; normal defaults live in config/runtime.toml.
KTA_SCOUT_MODEL=
KTA_CRITIC_MODEL=
KTA_REVIEWER_MODEL=
KTA_SUPERVISOR_MODEL=
KTA_DISCOVERY_MODEL=
KTA_RESEARCHER_MODEL=
KTA_THESIS_MODEL=
KTA_TRADE_MODEL=
# Bounded decisions need concise JSON; enable reasoning only after model-specific acceptance testing.
KTA_OPENROUTER_REASONING_EFFORT=none

# Perplexity runtime selection; its key lives in secrets.env.
KTA_PERPLEXITY_MODEL=sonar
